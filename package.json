{
  "name": "codex-provider-switch",
  "displayName": "Codex Switch",
  "description": "Switch Codex between ChatGPT and nine API-key providers from the VS Code sidebar.",
  "version": "0.4.2",
  "publisher": "macor-local",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/macorisd/codex-switch.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onView:codexSwitch.selector",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Codex Switch",
      "properties": {
        "codexSwitch.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.11+ executable for the local connector. Defaults to python on Windows and python3 on macOS/Linux. No additional Python packages are required."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSwitch",
          "title": "Codex Switch",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "codexSwitch": [
        {
          "type": "webview",
          "id": "codexSwitch.selector",
          "name": "Codex Switch",
          "contextualTitle": "Codex Switch"
        }
      ]
    },
    "commands": [
      {
        "command": "codexSwitch.open",
        "title": "Codex Switch: Open",
        "icon": "$(arrow-swap)"
      }
    ]
  },
  "scripts": {
    "brand": "node scripts/build-brand-assets.cjs",
    "test": "node --test test/*.test.js && python -S backend/test_switcher.py && python -S backend/test_api_providers.py && python -S -m unittest discover -s backend -p test_credential*.py && python -m unittest discover -s scripts -p test_*.py",
    "package": "vsce package --readme-path docs/extension-readme.md"
  },
  "files": [
    "extension.js",
    "codex-account.js",
    "media",
    "backend/bridge.py",
    "backend/switcher.py",
    "backend/credential_helper.py",
    "backend/credential_store.py",
    "backend/credential_native.py",
    "backend/vendor",
    "backend/requirements.txt",
    "backend/catalog.json",
    "docs/banner.svg",
    "docs/extension-readme.md",
    "LICENSE",
    "api-session.js",
    "backend/api_providers.py",
    "backend/providers.json"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "linkedom": "^0.18.12"
  }
}
