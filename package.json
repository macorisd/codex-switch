{
  "name": "codex-provider-switch",
  "displayName": "Codex Switch",
  "description": "Switch Codex between ChatGPT and nine API-key providers from the VS Code sidebar.",
  "version": "0.6.0",
  "publisher": "macor-local",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/macorisd/codex-switch.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*",
    "onView:codexSwitch.selector",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Codex Switch",
      "properties": {
        "codexSwitch.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Python 3.11+ executable on the host running Codex (the server for remote workspaces). Automatically discovers a compatible interpreter when empty. No additional Python packages are required."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSwitch",
          "title": "Codex Switch",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "codexSwitch": [
        {
          "type": "webview",
          "id": "codexSwitch.selector",
          "name": "Codex Switch",
          "contextualTitle": "Codex Switch"
        }
      ]
    },
    "commands": [
      {
        "command": "codexSwitch.open",
        "title": "Codex Switch: Open",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "codexSwitch.useBundledCodex",
        "title": "Codex Switch: Use bundled Codex executable"
      }
    ],
    "icons": {
      "codex-switch-openai": {
        "description": "openai provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E900"
        }
      },
      "codex-switch-deepseek": {
        "description": "deepseek provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E901"
        }
      },
      "codex-switch-openrouter": {
        "description": "openrouter provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E902"
        }
      },
      "codex-switch-openai-api": {
        "description": "openai-api provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E903"
        }
      },
      "codex-switch-zai": {
        "description": "zai provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E904"
        }
      },
      "codex-switch-moonshot": {
        "description": "moonshot provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E905"
        }
      },
      "codex-switch-qwen": {
        "description": "qwen provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E906"
        }
      },
      "codex-switch-xai": {
        "description": "xai provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E907"
        }
      },
      "codex-switch-minimax": {
        "description": "minimax provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E908"
        }
      },
      "codex-switch-mimo": {
        "description": "mimo provider",
        "default": {
          "fontPath": "./media/status-icons/providers.woff",
          "fontCharacter": "\\E909"
        }
      }
    }
  },
  "scripts": {
    "brand": "node scripts/build-brand-assets.cjs",
    "test": "node scripts/run-tests.cjs",
    "package": "vsce package --readme-path docs/extension-readme.md --allow-star-activation",
    "vscode:uninstall": "node ./recovery.js"
  },
  "files": [
    "extension.js",
    "codex-account.js",
    "media",
    "backend/bridge.py",
    "backend/switcher.py",
    "backend/credential_helper.py",
    "backend/credential_store.py",
    "backend/credential_native.py",
    "backend/vendor",
    "backend/requirements.txt",
    "backend/catalog.json",
    "docs/banner.svg",
    "docs/extension-readme.md",
    "LICENSE",
    "api-session.js",
    "backend/api_providers.py",
    "backend/providers.json",
    "workspace-runtime.js",
    "codex-spawn.js",
    "window-entry.js",
    "python-runtime.js",
    "client-settings.js",
    "credential-vault.js",
    "live-client.js",
    "codex-adapter.js",
    "backend/model_observer.py",
    "backend/credential_bridge.py",
    "backend/workspace_state.py",
    "backend/window_launcher.py",
    "backend/window_launcher.cs",
    "backend/model_defaults.py",
    "recovery.js",
    "node_modules/jsonc-parser/lib/umd/**",
    "node_modules/jsonc-parser/package.json",
    "node_modules/jsonc-parser/LICENSE.md",
    "usage-service.js",
    "usage-status.js",
    "backend/usage_metrics.py"
  ],
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "linkedom": "^0.18.12"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
